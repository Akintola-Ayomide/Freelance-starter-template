# =============================================================================
# FREELANCER STARTER — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# REQUIRED vars must be set for the app to start.
# OPTIONAL vars enable specific features when provided.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string.
# Local dev: use docker compose (pnpm db:up) with the values below.
# Production: use a managed provider like Neon (https://neon.tech) or Supabase.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancer_starter"

# Used by docker-compose.yml for local dev (override as needed)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=freelancer_starter
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# BETTER AUTH (REQUIRED)
# -----------------------------------------------------------------------------
# Generate a secret: openssl rand -base64 32
# Or use: pnpm init:project (generates one automatically)
BETTER_AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_-base64_32_min_32_chars"

# The canonical URL of this app (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# EMAIL — Resend (OPTIONAL)
# -----------------------------------------------------------------------------
# Get your API key at https://resend.com
# When absent, emails are logged to the console (perfect for local dev).
RESEND_API_KEY=""

# The "from" address for transactional emails.
# Must be from a verified Resend domain.
EMAIL_FROM="Freelancer Starter <noreply@example.com>"

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (OPTIONAL)
# -----------------------------------------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com
# Set the redirect URI to: {BETTER_AUTH_URL}/api/auth/callback/google
# Google OAuth is ONLY enabled when BOTH vars are present.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# SEED (OPTIONAL — only used by prisma/seed.ts)
# -----------------------------------------------------------------------------
# Override these for your seed data. Defaults to demo values if not set.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="AdminPassword123!"
SEED_ADMIN_NAME="Admin User"
SEED_DEMO_EMAIL="demo@example.com"
SEED_DEMO_PASSWORD="DemoPassword123!"
SEED_DEMO_NAME="Demo User"

# -----------------------------------------------------------------------------
# NEXT PUBLIC (available in browser)
# -----------------------------------------------------------------------------
# App URL — used for absolute links in emails, OG tags, etc.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
